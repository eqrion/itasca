# Rust extraction, specification generation and Lean verification.

# Keep the Aeneas revision in sync with ItascaRust/lakefile.toml and the manifests.
aeneas_rev := "557eff83ecef5083b98a52a94ca7fae63d6c1dab"
rust_toolchain := "nightly-2026-09-17"
opam_switch := env("OPAM_SWITCH", "itasca-lean")
xdg_cache := env("XDG_CACHE_HOME", "")
cache_dir := if xdg_cache == "" { env("HOME", "") + "/.cache" } else { xdg_cache }
tools_cache := absolute_path(env("TOOLS_CACHE", cache_dir + "/itasca"))
tools_dir := tools_cache + "/aeneas-" + aeneas_rev
aeneas := tools_dir + "/bin/aeneas"
charon := tools_dir + "/bin/charon"
spectec_dir := "../vendor/spectec/spectec"
spec_sources := "specification/wasm-2.0"
spec_inputs := "0-aux.spectec 1-syntax.spectec 2-syntax-aux.spectec 6-typing.spectec"
rust_model_dir := "ItascaRust"
spec_model := "WebAssembly/WebAssembly.lean"

default:
    @just --list

clean:
    @rm -rf Itasca/.lake/build ItascaRust/.lake/build WebAssembly/.lake/build

install-tools:
    @sh install-tools.sh {{ quote(tools_dir) }} {{ aeneas_rev }} {{ rust_toolchain }} {{ quote(opam_switch) }}

check-tools:
    @test -x {{ quote(aeneas) }} && test -x {{ quote(charon) }} && test -x {{ quote(charon + "-driver") }} || { echo "Run just tools to install the pinned extraction tools."; exit 1; }

# Keep extraction outputs separate from ordinary Rust tests and release builds.
# The extraction cfg omits unsupported trait implementations.
[working-directory("..")]
_llbc: check-tools
    @mkdir -p lean/.build
    @RUSTUP_TOOLCHAIN={{ rust_toolchain }} CARGO_TARGET_DIR="$PWD/lean/.build/cargo" \
        RUSTFLAGS=--cfg=charon \
        {{ quote(charon) }} cargo --preset=aeneas --sysroot=default --rustc-arg=--cfg=charon \
        --rustc-arg=-Adead_code \
        --opaque='itasca::stream::share_code' \
        --exclude='{impl core::clone::Clone for _}' \
        --exclude='{impl core::marker::Copy for _}' \
        --include='core::marker::{impl core::marker::Copy for u8}' \
        --include='core::clone::impls::{impl core::clone::Clone for u8}' \
        --dest-file="$PWD/lean/.build/itasca.llbc"

_extract-to destination: _llbc
    @mkdir -p {{ quote(destination) }}
    @{{ quote(aeneas) }} -backend lean .build/itasca.llbc -dest {{ quote(destination) }} -subdir {{ rust_model_dir }} -split-files -namespace Itasca -no-progress-bar
    @generated={{ quote(destination + "/" + rust_model_dir) }}; \
        sed -E -i.bak "s/(Source: '[^']*'), lines [0-9]+:[0-9]+-[0-9]+:[0-9]+/\1/g" \
            "$generated/Types.lean" "$generated/Funs.lean" && \
        rm "$generated/Types.lean.bak" "$generated/Funs.lean.bak"

extract: (_extract-to rust_model_dir)

# Regenerate into a separate directory and reject stale committed models.
extract-check: (_extract-to ".build/extract-check")
    @for file in Types Funs; do \
        cmp ".build/extract-check/{{ rust_model_dir }}/$file.lean" "{{ rust_model_dir }}/{{ rust_model_dir }}/$file.lean" || exit 1; \
    done

prove:
    @lake -d Itasca build Itasca ItascaRust WebAssembly

audit:
    @lake -d Itasca build audit

# Prepare the selected sources from the pinned submodule in scratch space.
spec-patch:
    @mkdir -p .build/spec/spectec .build/spec/{{ spec_sources }}
    @revision=$(git rev-parse HEAD:vendor/spectec) && \
        for input in {{ spec_inputs }}; do \
            git -C ../vendor/spectec show "$revision:{{ spec_sources }}/$input" \
                > ".build/spec/{{ spec_sources }}/$input" || exit 1; \
        done
    @for patch_name in global-mutability validation; do \
        patch -f -F 0 -p1 -d .build/spec < "../patches/spectec-wasm2-$patch_name.patch" || exit 1; \
    done

# Generate the local specification in scratch space before comparing or updating it.
_spec-generate: spec-patch
    # SpecTec's executable links the reference-interpreter backend.
    @make -C {{ spectec_dir }} src/backend-interpreter/reference-interpreter
    @cd {{ spectec_dir }} && opam exec --switch={{ quote(opam_switch) }} -- dune build src/exe-spectec/main.exe
    @spectec="$PWD/{{ spectec_dir }}/_build/default/src/exe-spectec/main.exe"; \
        cd .build/spec/spectec && \
        set -- && \
        for input in {{ spec_inputs }}; do set -- "$@" "../{{ spec_sources }}/$input"; done && \
        "$spectec" "$@" --lean --single-pattern-match --wf-state all -o ../wasm2.0.lean
    @patch -f -F 0 -p1 -d .build/spec < ../patches/spectec-wasm2-lean.patch

spec-check: _spec-generate
    @cmp .build/spec/wasm2.0.lean {{ spec_model }}

spec-update: _spec-generate
    @cp .build/spec/wasm2.0.lean {{ spec_model }}
