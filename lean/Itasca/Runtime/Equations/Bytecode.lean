import Itasca.Generated.FunsRuntimeCommon

/-! Constructor equations for the generated bytecode classifiers.

Compiler and shared representation proofs import this module without interpreter
execution definitions. Each equation is proved by reflexivity and checked by the
kernel. Emitting these equations directly avoids Lean's quadratic-size auxiliary
proofs for the shared 432-alternative matcher. The standard equation names let
`simp` reuse them without generating matcher equations in each consumer.
-/

namespace Itasca.Automation
open Lean Meta

/-- Emit constructor equations using reflexivity. `addDecl` kernel-checks every proof.
The generated functions have one monomorphic instruction argument; no extracted
source or operation identity is changed. -/
def emitInstructionEquations (function : Name) : MetaM Unit := do
  let info ← getConstInfoDefn function
  let instr ← getConstInfoInduct ``Itasca.runtime.bytecode.Instr
  forallTelescope info.type fun parameters _ => do
    let mut position := none
    for i in [:parameters.size] do
      if (← inferType parameters[i]!).isConstOf instr.name then
        if position.isSome then throwError "multiple instruction parameters"
        position := some i
    let some index := position | throwError "missing instruction parameter"
    for i in [:instr.ctors.length] do
      let constructor := instr.ctors[i]!
      let ctor ← getConstInfoCtor constructor
      forallTelescope ctor.type fun fields _ => do
        let argument := mkAppN (mkConst constructor) fields
        let arguments := parameters.set! index argument
        let binders := parameters[:index].toArray ++ fields ++ parameters[index+1:].toArray
        let lhs := mkAppN (mkConst function (info.levelParams.map mkLevelParam)) arguments
        let rhs ← withReducible <| whnf (info.value.beta arguments)
        let type ← mkForallFVars binders (← mkEq lhs rhs)
        let value ← mkLambdaFVars binders (← mkEqRefl lhs)
        let equationName := mkEqLikeNameFor (← getEnv) function s!"eq_{i+1}"
        addDecl (.thmDecl ⟨⟨equationName, info.levelParams, type⟩, value, [equationName]⟩)
        inferDefEqAttr equationName

end Itasca.Automation

run_meta Itasca.Automation.emitInstructionEquations ``Itasca.runtime.bytecode.Instr.scalar
run_meta Itasca.Automation.emitInstructionEquations ``Itasca.runtime.bytecode.Instr.load
run_meta Itasca.Automation.emitInstructionEquations ``Itasca.runtime.bytecode.Instr.store
run_meta Itasca.Automation.emitInstructionEquations ``Itasca.runtime.bytecode.Instr.simd
run_meta Itasca.Automation.emitInstructionEquations ``Itasca.runtime.bytecode.Instr.retarget
run_meta Itasca.Automation.emitInstructionEquations ``Itasca.runtime.bytecode.is_return
run_meta Itasca.Automation.emitInstructionEquations ``Itasca.runtime.bytecode.CompiledFunction.other_valid
