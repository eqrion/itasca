/-- [itasca::code::read_simd_memory_lane]:
    Source: 'src/code.rs' -/
def code.read_simd_memory_lane
  (st : code.OpIterState) (data : Slice Std.U8) (env : metadata.Env)
  (natural_align : Std.U32) (store : Bool) (count : Std.U8) :
  Result ((core.result.Result (code.MemArg × Std.U8) error.OpError) ×
    code.OpIterState)
  := do
  let (r, st1) ← code.read_memarg st data
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val =>
    let (r1, st2) ← code.take_simd_lane st1 data count
    let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
    match cf1 with
    | core.ops.control_flow.ControlFlow.Continue val1 =>
      let r2 ← code.check_memory_and_alignment env val natural_align
      let cf2 ← core.result.Result.Insts.CoreOpsTry.branch r2
      match cf2 with
      | core.ops.control_flow.ControlFlow.Continue _ =>
        let (r3, st3) ← code.pop_with_type st2 wasm_types.ValueType.V128
        let cf3 ← core.result.Result.Insts.CoreOpsTry.branch r3
        match cf3 with
        | core.ops.control_flow.ControlFlow.Continue _ =>
          let (r4, st4) ← code.pop_with_type st3 wasm_types.ValueType.I32
          let cf4 ← core.result.Result.Insts.CoreOpsTry.branch r4
          match cf4 with
          | core.ops.control_flow.ControlFlow.Continue _ =>
            if store
            then ok (core.result.Result.Ok (val, val1), st4)
            else
              let st5 ←
                code.push_val st4 (code.StackType.Val
                  wasm_types.ValueType.V128)
              ok (core.result.Result.Ok (val, val1), st5)
          | core.ops.control_flow.ControlFlow.Break residual =>
            let r5 ←
              core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
                (code.MemArg × Std.U8) (core.convert.FromSame error.OpError)
                residual
            ok (r5, st4)
        | core.ops.control_flow.ControlFlow.Break residual =>
          let r4 ←
            core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
              (code.MemArg × Std.U8) (core.convert.FromSame error.OpError)
              residual
          ok (r4, st3)
      | core.ops.control_flow.ControlFlow.Break residual =>
        let r3 ←
          core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
            (code.MemArg × Std.U8) (core.convert.FromSame error.OpError)
            residual
        ok (r3, st2)
    | core.ops.control_flow.ControlFlow.Break residual =>
      let r2 ←
        core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
          (code.MemArg × Std.U8) (core.convert.FromSame error.OpError)
          residual
      ok (r2, st2)
  | core.ops.control_flow.ControlFlow.Break residual =>
    let r1 ←
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        (code.MemArg × Std.U8) (core.convert.FromSame error.OpError) residual
    ok (r1, st1)

/-- [itasca::code::take_simd_bits]:
    Source: 'src/code.rs' -/
def code.take_simd_bits
  (st : code.OpIterState) (data : Slice Std.U8) :
  Result ((core.result.Result (Std.U64 × Std.U64) error.OpError) ×
    code.OpIterState)
  := do
  let r ← reader.read_f64_bits data st.pos
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val =>
    let (low, p1) := val
    let r1 ← reader.read_f64_bits data p1
    let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
    match cf1 with
    | core.ops.control_flow.ControlFlow.Continue val1 =>
      let (high, p2) := val1
      ok (core.result.Result.Ok (low, high), { st with pos := p2 })
    | core.ops.control_flow.ControlFlow.Break residual =>
      let r2 ←
        core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
          (Std.U64 × Std.U64) (core.convert.FromSame error.OpError) residual
      ok (r2, st)
  | core.ops.control_flow.ControlFlow.Break residual =>
    let r1 ←
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        (Std.U64 × Std.U64) (core.convert.FromSame error.OpError) residual
    ok (r1, st)

/-- [itasca::code::read_simd_const]:
    Source: 'src/code.rs' -/
def code.read_simd_const
  (st : code.OpIterState) (data : Slice Std.U8) :
  Result ((core.result.Result (Std.U64 × Std.U64) error.OpError) ×
    code.OpIterState)
  := do
  let (r, st1) ← code.take_simd_bits st data
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val =>
    let st2 ←
