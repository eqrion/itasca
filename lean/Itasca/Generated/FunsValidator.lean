/-- [itasca::code::take_simd_lane]:
    Source: 'src/code.rs' -/
def code.take_simd_lane
  (st : code.OpIterState) (data : Slice Std.U8) (count : Std.U8) :
  Result ((core.result.Result Std.U8 error.OpError) × code.OpIterState)
  := do
  let r ← reader.read_byte data st.pos
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val =>
    let (lane, next) := val
    if lane >= count
    then
      ok (core.result.Result.Err error.OpError.InvalidLane,
        { st with pos := next })
    else ok (core.result.Result.Ok lane, { st with pos := next })
  | core.ops.control_flow.ControlFlow.Break residual =>
    let r1 ←
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        Std.U8 (core.convert.FromSame error.OpError) residual
    ok (r1, st)

/-- [itasca::code::read_simd_lane]:
    Source: 'src/code.rs' -/
def code.read_simd_lane
  (st : code.OpIterState) (data : Slice Std.U8) (ty : wasm_types.ValueType)
  (count : Std.U8) (replace : Bool) :
  Result ((core.result.Result Std.U8 error.OpError) × code.OpIterState)
  := do
  let (r, st1) ← code.take_simd_lane st data count
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val =>
    if replace
    then
      let (r1, st2) ← code.pop_with_type st1 ty
      let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
      match cf1 with
      | core.ops.control_flow.ControlFlow.Continue _ =>
        let (r2, st3) ←
          code.read_conversion st2 wasm_types.ValueType.V128
            wasm_types.ValueType.V128
        let cf2 ← core.result.Result.Insts.CoreOpsTry.branch r2
        match cf2 with
        | core.ops.control_flow.ControlFlow.Continue _ =>
          ok (core.result.Result.Ok val, st3)
        | core.ops.control_flow.ControlFlow.Break residual =>
          let r3 ←
            core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
              Std.U8 (core.convert.FromSame error.OpError) residual
          ok (r3, st3)
      | core.ops.control_flow.ControlFlow.Break residual =>
        let r2 ←
          core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
            Std.U8 (core.convert.FromSame error.OpError) residual
        ok (r2, st2)
    else
      let (r1, st2) ← code.read_conversion st1 wasm_types.ValueType.V128 ty
      let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
      match cf1 with
      | core.ops.control_flow.ControlFlow.Continue _ =>
        ok (core.result.Result.Ok val, st2)
      | core.ops.control_flow.ControlFlow.Break residual =>
        let r2 ←
          core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
            Std.U8 (core.convert.FromSame error.OpError) residual
        ok (r2, st2)
  | core.ops.control_flow.ControlFlow.Break residual =>
    let r1 ←
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        Std.U8 (core.convert.FromSame error.OpError) residual
    ok (r1, st1)

