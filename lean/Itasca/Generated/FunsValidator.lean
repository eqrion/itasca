/-- [itasca::code::read_simd_signature]:
    Source: 'src/code.rs' -/
def code.read_simd_signature
  (st : code.OpIterState) (signature : code.SimdSignature) :
  Result ((core.result.Result Unit error.OpError) × code.OpIterState)
  := do
  match signature with
  | code.SimdSignature.Unary =>
    code.read_conversion st wasm_types.ValueType.V128 wasm_types.ValueType.V128
  | code.SimdSignature.Binary =>
    code.read_binary st wasm_types.ValueType.V128 wasm_types.ValueType.V128
  | code.SimdSignature.Ternary =>
    let (r, st1) ← code.pop_with_type st wasm_types.ValueType.V128
    let cf ← core.result.Result.Insts.CoreOpsTry.branch r
    match cf with
    | core.ops.control_flow.ControlFlow.Continue _ =>
      code.read_binary st1 wasm_types.ValueType.V128 wasm_types.ValueType.V128
    | core.ops.control_flow.ControlFlow.Break residual =>
      let r1 ←
        core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
          Unit (core.convert.FromSame error.OpError) residual
      ok (r1, st1)
  | code.SimdSignature.Test =>
    code.read_conversion st wasm_types.ValueType.V128 wasm_types.ValueType.I32
  | code.SimdSignature.Shift =>
    let (r, st1) ← code.pop_with_type st wasm_types.ValueType.I32
    let cf ← core.result.Result.Insts.CoreOpsTry.branch r
    match cf with
    | core.ops.control_flow.ControlFlow.Continue _ =>
      code.read_conversion st1 wasm_types.ValueType.V128
        wasm_types.ValueType.V128
    | core.ops.control_flow.ControlFlow.Break residual =>
      let r1 ←
        core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
          Unit (core.convert.FromSame error.OpError) residual
      ok (r1, st1)
  | code.SimdSignature.SplatI32 =>
    code.read_conversion st wasm_types.ValueType.I32 wasm_types.ValueType.V128
  | code.SimdSignature.SplatI64 =>
    code.read_conversion st wasm_types.ValueType.I64 wasm_types.ValueType.V128
  | code.SimdSignature.SplatF32 =>
    code.read_conversion st wasm_types.ValueType.F32 wasm_types.ValueType.V128
  | code.SimdSignature.SplatF64 =>
    code.read_conversion st wasm_types.ValueType.F64 wasm_types.ValueType.V128

