    Source: 'src/code.rs' -/
def code.step_numeric
  {V : Type} (OpVisitorInst : code.OpVisitor V) (st : code.OpIterState)
  (opcode : Std.U8) (v : V) :
  Result ((core.result.Result Unit error.OpError) × code.OpIterState × V)
  := do
  let o ← code.convert_types opcode
  match o with
  | none =>
