  := do
  match opcode with
  | 0#uscalar => ok (some (wasm_types.ValueType.F32, wasm_types.ValueType.I32))
  | 1#uscalar => ok (some (wasm_types.ValueType.F32, wasm_types.ValueType.I32))
  | 2#uscalar => ok (some (wasm_types.ValueType.F64, wasm_types.ValueType.I32))
  | 3#uscalar => ok (some (wasm_types.ValueType.F64, wasm_types.ValueType.I32))
  | 4#uscalar => ok (some (wasm_types.ValueType.F32, wasm_types.ValueType.I64))
  | 5#uscalar => ok (some (wasm_types.ValueType.F32, wasm_types.ValueType.I64))
  | 6#uscalar => ok (some (wasm_types.ValueType.F64, wasm_types.ValueType.I64))
  | 7#uscalar => ok (some (wasm_types.ValueType.F64, wasm_types.ValueType.I64))
  | _ => ok none

