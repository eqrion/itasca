def code.initial_state
  (env : metadata.Env) (type_index : Std.U32) :
  Result (core.result.Result code.BodyState error.OpError)
  := do
  let i ← lift (UScalar.cast .Usize type_index)
  let i1 := alloc.vec.Vec.len env.types
  if i >= i1
  then ok (core.result.Result.Err error.OpError.UnknownType)
  else
    let ft ←
      alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
        wasm_types.FuncType) env.types i
    let r ← code.check_func_type ft
    let cf ← core.result.Result.Insts.CoreOpsTry.branch r
    match cf with
    | core.ops.control_flow.ControlFlow.Continue _ =>
      let st ←
        code.push_frame
          {
            core :=
              {
                vals := (alloc.vec.Vec.new code.StackType),
                ctrls := (alloc.vec.Vec.new code.Ctrl),
                pos := 0#usize
              }
          } code.LabelKind.Body (signature.BlockType.TypeIndex type_index)
      ok (core.result.Result.Ok st)
    | core.ops.control_flow.ControlFlow.Break residual =>
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        code.BodyState (core.convert.FromSame error.OpError) residual

