def code.sign_extension_type
  (opcode : Std.U8) : Result (Option wasm_types.ValueType) := do
  match opcode with
  | 192#uscalar => ok (some wasm_types.ValueType.I32)
  | 193#uscalar => ok (some wasm_types.ValueType.I32)
  | 194#uscalar => ok (some wasm_types.ValueType.I64)
  | 195#uscalar => ok (some wasm_types.ValueType.I64)
  | 196#uscalar => ok (some wasm_types.ValueType.I64)
  | _ => ok none

/-- [itasca::code::saturating_types]:
