def code.cur_base
  (st : _root_.Itasca.code.OpIterState) : Result Std.Usize := do
  let n := alloc.vec.Vec.len st.ctrls
  if n = 0#usize
  then ok 0#usize
  else
    let i ← n - 1#usize
    let c ←
      alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
        _root_.Itasca.code.Ctrl) st.ctrls i
    ok c.value_stack_base

