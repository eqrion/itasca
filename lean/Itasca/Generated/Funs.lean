  (st : _root_.Itasca.code.OpIterState)
  (expected : _root_.Itasca.types.ValueType) :
  Result ((core.result.Result _root_.Itasca.code.StackType
    _root_.Itasca.error.OpError) × _root_.Itasca.code.OpIterState)
