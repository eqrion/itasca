/-- [itasca::runtime::bytecode::{itasca::runtime::bytecode::Instr}::make_load]:
    Source: 'src/runtime/bytecode.rs' -/
def runtime.bytecode.Instr.make_load
  (op : Std.U16) (dst : Std.U32) (addr : Std.U32) (offset : Std.U32) :
  Result (Option runtime.bytecode.Instr)
  := do
  match op with
  | 40#uscalar => ok (some (runtime.bytecode.Instr.I32Load dst addr offset))
  | 41#uscalar => ok (some (runtime.bytecode.Instr.I64Load dst addr offset))
  | 42#uscalar => ok (some (runtime.bytecode.Instr.F32Load dst addr offset))
  | 43#uscalar => ok (some (runtime.bytecode.Instr.F64Load dst addr offset))
  | 44#uscalar => ok (some (runtime.bytecode.Instr.I32Load8S dst addr offset))
  | 45#uscalar => ok (some (runtime.bytecode.Instr.I32Load8U dst addr offset))
  | 46#uscalar => ok (some (runtime.bytecode.Instr.I32Load16S dst addr offset))
  | 47#uscalar => ok (some (runtime.bytecode.Instr.I32Load16U dst addr offset))
  | 48#uscalar => ok (some (runtime.bytecode.Instr.I64Load8S dst addr offset))
  | 49#uscalar => ok (some (runtime.bytecode.Instr.I64Load8U dst addr offset))
  | 50#uscalar => ok (some (runtime.bytecode.Instr.I64Load16S dst addr offset))
  | 51#uscalar => ok (some (runtime.bytecode.Instr.I64Load16U dst addr offset))
  | 52#uscalar => ok (some (runtime.bytecode.Instr.I64Load32S dst addr offset))
  | 53#uscalar => ok (some (runtime.bytecode.Instr.I64Load32U dst addr offset))
  | _ => ok none

