/-- [itasca::runtime::bytecode::{itasca::runtime::bytecode::Instr}::make_store]:
    Source: 'src/runtime/bytecode.rs' -/
def runtime.bytecode.Instr.make_store
  (op : Std.U16) (addr : Std.U32) (value : Std.U32) (offset : Std.U32) :
  Result (Option runtime.bytecode.Instr)
  := do
  match op with
  | 54#uscalar => ok (some (runtime.bytecode.Instr.I32Store addr value offset))
  | 55#uscalar => ok (some (runtime.bytecode.Instr.I64Store addr value offset))
  | 56#uscalar => ok (some (runtime.bytecode.Instr.F32Store addr value offset))
  | 57#uscalar => ok (some (runtime.bytecode.Instr.F64Store addr value offset))
  | 58#uscalar =>
    ok (some (runtime.bytecode.Instr.I32Store8 addr value offset))
  | 59#uscalar =>
    ok (some (runtime.bytecode.Instr.I32Store16 addr value offset))
  | 60#uscalar =>
    ok (some (runtime.bytecode.Instr.I64Store8 addr value offset))
  | 61#uscalar =>
    ok (some (runtime.bytecode.Instr.I64Store16 addr value offset))
  | 62#uscalar =>
    ok (some (runtime.bytecode.Instr.I64Store32 addr value offset))
  | _ => ok none

