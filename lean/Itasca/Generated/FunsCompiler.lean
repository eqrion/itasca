def runtime.compiler.initialize.expression
  {A : Type} (platformAllocInst : runtime.platform.Alloc A)
  (module : runtime.compiler.ExecutableModule)
  (budget : runtime.compiler.Budget A) (expr : wasm_types.ConstExpr)
  (ty : wasm_types.ValueType) :
  Result ((core.result.Result Std.Usize error.VisitError) ×
    runtime.compiler.ExecutableModule × (runtime.compiler.Budget A))
  := do
  let i ← runtime.value.width ty
  let function ←
    runtime.bytecode.CompiledFunction.synthetic (alloc.vec.Vec.new
      runtime.bytecode.Instr) i
  let (r, budget1, function1) ←
    runtime.compiler.initialize.constant platformAllocInst budget function expr
      ty 0#u32
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue _ =>
    let (r1, budget2, v) ←
      runtime.compiler.initialize.emit platformAllocInst budget1 function1.code
        (runtime.bytecode.Instr.Return 0#u32 i)
    let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
    match cf1 with
    | core.ops.control_flow.ControlFlow.Continue _ =>
      let index := alloc.vec.Vec.len module.functions
      let b ←
        runtime.bytecode.CompiledFunction.well_formed
          { function1 with code := v }
      if b
      then
        let (r2, budget3, v1) ←
          runtime.compiler.Budget.push platformAllocInst budget2
            module.functions { function1 with code := v }
        let cf2 ← core.result.Result.Insts.CoreOpsTry.branch r2
        match cf2 with
        | core.ops.control_flow.ControlFlow.Continue _ =>
          ok (core.result.Result.Ok index, { module with functions := v1 },
            budget3)
        | core.ops.control_flow.ControlFlow.Break residual =>
          let r3 ←
            core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
              Std.Usize (core.convert.FromSame error.VisitError) residual
          ok (r3, { module with functions := v1 }, budget3)
      else
        ok (core.result.Result.Err error.VisitError.OutOfMemory, module,
          budget2)
    | core.ops.control_flow.ControlFlow.Break residual =>
      let r2 ←
        core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
          Std.Usize (core.convert.FromSame error.VisitError) residual
      ok (r2, module, budget2)
  | core.ops.control_flow.ControlFlow.Break residual =>
    let r1 ←
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        Std.Usize (core.convert.FromSame error.VisitError) residual
    ok (r1, module, budget1)

