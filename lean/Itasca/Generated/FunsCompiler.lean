def runtime.compiler.FunctionCompiler.pair
  {A : Type} (platformAllocInst : runtime.platform.Alloc A)
  (self : runtime.compiler.FunctionCompiler A) (a : Std.U32) (b : Std.U32) :
  Result ((core.result.Result Std.U32 error.VisitError) ×
    (runtime.compiler.FunctionCompiler A))
  := do
  let i := alloc.vec.Vec.len self.function.indirect
  let r ← runtime.compiler.bounded_index i
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val =>
    let (r1, b1, v) ←
      runtime.compiler.Budget.push platformAllocInst self.budget
        self.function.indirect (a, b)
    let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
    match cf1 with
    | core.ops.control_flow.ControlFlow.Continue _ =>
      ok (core.result.Result.Ok val,
        {
          self
            with
            budget := b1, function := { self.function with indirect := v }
        })
    | core.ops.control_flow.ControlFlow.Break residual =>
      let r2 ←
        core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
          Std.U32 (core.convert.FromSame error.VisitError) residual
      ok (r2,
        {
          self
            with
            budget := b1, function := { self.function with indirect := v }
        })
  | core.ops.control_flow.ControlFlow.Break residual =>
    let r1 ←
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        Std.U32 (core.convert.FromSame error.VisitError) residual
    ok (r1, self)

/-- [itasca::runtime::compiler::{itasca::runtime::compiler::FunctionCompiler<'a, A>}::copy]:
    Source: 'src/runtime/compiler/mod.rs' -/
def runtime.compiler.FunctionCompiler.copy
  {A : Type} (platformAllocInst : runtime.platform.Alloc A)
  (self : runtime.compiler.FunctionCompiler A) (dst : Std.U32) (src : Std.U32)
  (n : Std.U32) :
  Result ((core.result.Result Unit error.VisitError) ×
    (runtime.compiler.FunctionCompiler A))
  := do
  if n = 0#u32
  then ok (core.result.Result.Ok (), self)
  else
    if src = dst
    then ok (core.result.Result.Ok (), self)
    else
      let instruction ←
        match n with
        | 1#uscalar => ok (runtime.bytecode.Instr.Copy dst src)
        | 2#uscalar => ok (runtime.bytecode.Instr.Copy2 dst src)
        | _ => ok (runtime.bytecode.Instr.CopyN dst src n)
      runtime.compiler.FunctionCompiler.emit platformAllocInst self instruction

