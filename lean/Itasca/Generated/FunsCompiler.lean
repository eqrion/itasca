/-- [itasca::runtime::compiler::lower::top_is_v128]:
    Source: 'src/runtime/compiler/lower.rs' -/
def runtime.compiler.lower.top_is_v128
  (values : Slice code.StackType) : Result Bool := do
  let b ← core.slice.Slice.is_empty values
  if b
  then ok false
  else
    let i := Slice.len values
    let i1 ← i - 1#usize
    let ty ← Slice.index_usize values i1
    match ty with
    | code.StackType.Val vt =>
      match vt with
      | wasm_types.ValueType.I32 => ok false
      | wasm_types.ValueType.I64 => ok false
      | wasm_types.ValueType.F32 => ok false
      | wasm_types.ValueType.F64 => ok false
      | wasm_types.ValueType.V128 => ok true
      | wasm_types.ValueType.FuncRef => ok false
      | wasm_types.ValueType.ExternRef => ok false
    | code.StackType.Bot => ok false

