    (runtime.compiler.Budget A) × runtime.bytecode.CompiledFunction)
  := do
  match expr with
  | wasm_types.ConstExpr.I32 v =>
    let i ← lift (IScalar.hcast .U32 v)
    let (r, budget1, v1) ←
      runtime.compiler.initialize.emit platformAllocInst budget function.code
        (runtime.bytecode.Instr.Const32 dst i)
    ok (r, budget1, { function with code := v1 })
  | wasm_types.ConstExpr.I64 v =>
    let i ← lift (IScalar.hcast .U64 v)
    let (r, budget1, v1) ←
      runtime.compiler.initialize.emit platformAllocInst budget function.code
        (runtime.bytecode.Instr.Const64 dst i)
    ok (r, budget1, { function with code := v1 })
  | wasm_types.ConstExpr.F32 value =>
    let (r, budget1, v) ←
      runtime.compiler.initialize.emit platformAllocInst budget function.code
        (runtime.bytecode.Instr.Const32 dst value)
    ok (r, budget1, { function with code := v })
  | wasm_types.ConstExpr.F64 value =>
    let (r, budget1, v) ←
      runtime.compiler.initialize.emit platformAllocInst budget function.code
        (runtime.bytecode.Instr.Const64 dst value)
    ok (r, budget1, { function with code := v })
  | wasm_types.ConstExpr.V128 lo hi =>
    let i := alloc.vec.Vec.len function.v128_pool
    let r ← runtime.compiler.bounded_index i
    let cf ← core.result.Result.Insts.CoreOpsTry.branch r
    match cf with
    | core.ops.control_flow.ControlFlow.Continue val =>
      let i1 ← lift (UScalar.cast .U128 lo)
      let i2 ← lift (UScalar.cast .U128 hi)
      let i3 ← i2 <<< 64#i32
      let i4 ← lift (i1 ||| i3)
      let (r1, budget1, v) ←
        runtime.compiler.Budget.push platformAllocInst budget
          function.v128_pool i4
      let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
      match cf1 with
      | core.ops.control_flow.ControlFlow.Continue _ =>
        let (r2, budget2, v1) ←
          runtime.compiler.initialize.emit platformAllocInst budget1
            function.code (runtime.bytecode.Instr.ConstV128 dst val)
        ok (r2, budget2, { function with code := v1, v128_pool := v })
      | core.ops.control_flow.ControlFlow.Break residual =>
        let r2 ←
          core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
            Unit (core.convert.FromSame error.VisitError) residual
        ok (r2, budget1, { function with v128_pool := v })
    | core.ops.control_flow.ControlFlow.Break residual =>
      let r1 ←
        core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
          Unit (core.convert.FromSame error.VisitError) residual
      ok (r1, budget, function)
  | wasm_types.ConstExpr.RefNull _ =>
    let (r, budget1, v) ←
      runtime.compiler.initialize.emit platformAllocInst budget function.code
        (runtime.bytecode.Instr.RefNull dst)
    ok (r, budget1, { function with code := v })
  | wasm_types.ConstExpr.RefFunc func =>
    let (r, budget1, v) ←
      runtime.compiler.initialize.emit platformAllocInst budget function.code
        (runtime.bytecode.Instr.RefFunc dst func)
    ok (r, budget1, { function with code := v })
  | wasm_types.ConstExpr.GlobalGet global =>
    let instruction ←
      match ty with
      | wasm_types.ValueType.I32 =>
        ok (runtime.bytecode.Instr.GlobalGet dst global)
      | wasm_types.ValueType.I64 =>
        ok (runtime.bytecode.Instr.GlobalGet dst global)
      | wasm_types.ValueType.F32 =>
        ok (runtime.bytecode.Instr.GlobalGet dst global)
      | wasm_types.ValueType.F64 =>
        ok (runtime.bytecode.Instr.GlobalGet dst global)
      | wasm_types.ValueType.V128 =>
        ok (runtime.bytecode.Instr.GlobalGet2 dst global)
      | wasm_types.ValueType.FuncRef =>
        ok (runtime.bytecode.Instr.GlobalGet dst global)
      | wasm_types.ValueType.ExternRef =>
        ok (runtime.bytecode.Instr.GlobalGet dst global)
    let (r, budget1, v) ←
      runtime.compiler.initialize.emit platformAllocInst budget function.code
        instruction
    ok (r, budget1, { function with code := v })

