/-- [itasca::runtime::interp::execute_load]:
    Source: 'src/runtime/interp/mod.rs' -/
def runtime.interp.execute_load
  {M : Type} (platformMemoryBufferInst : runtime.platform.MemoryBuffer M)
  (exec : runtime.interp.Execution) (store : runtime.store.Store M)
  (inst : Std.Usize) (base : Std.Usize) (op : Std.U16) (dst : Std.U32)
  (addr : Std.U32) (offset : Std.U32) :
  Result ((core.result.Result Unit runtime.ExecError) ×
    runtime.interp.Execution)
  := do
  let mi ←
    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
      runtime.store.ModuleInst) store.instances inst
  let ma ←
    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
      runtime.MemoryAddr) mi.memories 0#usize
  let i ← lift (UScalar.cast .Usize addr)
  let i1 ← base + i
  let i2 ←
    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice Std.U64)
      exec.slots i1
  let i3 ← lift (UScalar.cast .U32 i2)
  let mi1 ←
    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
      (runtime.store.MemInst M)) store.memories ma.index
  let s ← platformMemoryBufferInst.bytes mi1.buf
  let r ← runtime.interp.memory.load op i3 offset s
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val =>
    let i4 ← lift (UScalar.cast .Usize dst)
    let i5 ← base + i4
    let (_, index_mut_back) ←
      alloc.vec.Vec.index_mut (core.slice.index.SliceIndexUsizeSlice Std.U64)
        exec.slots i5
    let v := index_mut_back val
    ok (core.result.Result.Ok (), { exec with slots := v })
  | core.ops.control_flow.ControlFlow.Break residual =>
    let r1 ←
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        Unit (core.convert.FromSame runtime.ExecError) residual
    ok (r1, exec)

/-- [itasca::runtime::interp::dispatch_load]:
    Source: 'src/runtime/interp/mod.rs' -/
def runtime.interp.dispatch_load
  {M : Type} (platformMemoryBufferInst : runtime.platform.MemoryBuffer M)
  (exec : runtime.interp.Execution) (store : runtime.store.Store M)
  (inst : Std.Usize) (base : Std.Usize) (op : Std.U16)
  (instruction : runtime.bytecode.Instr) :
  Result ((core.result.Result Unit runtime.ExecError) ×
    runtime.interp.Execution)
  := do
  let (dst, addr, offset) ← runtime.interp.load_operands instruction
  runtime.interp.execute_load platformMemoryBufferInst exec store inst base op
    dst addr offset

