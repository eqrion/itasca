/-- [itasca::runtime::interp::execute_store]:
    Source: 'src/runtime/interp/mod.rs' -/
def runtime.interp.execute_store
  {M : Type} (platformMemoryBufferInst : runtime.platform.MemoryBuffer M)
  (exec : runtime.interp.Execution) (store : runtime.store.Store M)
  (inst : Std.Usize) (base : Std.Usize) (op : Std.U16) (addr : Std.U32)
  (value : Std.U32) (offset : Std.U32) :
  Result ((core.result.Result Unit runtime.ExecError) × (runtime.store.Store
    M))
  := do
  let mi ←
    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
      runtime.store.ModuleInst) store.instances inst
  let ma ←
    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
      runtime.MemoryAddr) mi.memories 0#usize
  let i ← lift (UScalar.cast .Usize addr)
  let i1 ← base + i
  let i2 ←
    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice Std.U64)
      exec.slots i1
  let i3 ← lift (UScalar.cast .U32 i2)
  let i4 ← lift (UScalar.cast .Usize value)
  let i5 ← base + i4
  let i6 ←
    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice Std.U64)
      exec.slots i5
  let (mi1, index_mut_back) ←
    alloc.vec.Vec.index_mut (core.slice.index.SliceIndexUsizeSlice
      (runtime.store.MemInst M)) store.memories ma.index
  let (s, bytes_mut_back) ← platformMemoryBufferInst.bytes_mut mi1.buf
  let (r, s1) ← runtime.interp.memory.store op i3 offset i6 s
  let t := bytes_mut_back s1
  let v := index_mut_back { mi1 with buf := t }
  ok (r, { store with memories := v })

/-- [itasca::runtime::interp::dispatch_store]:
    Source: 'src/runtime/interp/mod.rs' -/
def runtime.interp.dispatch_store
  {M : Type} (platformMemoryBufferInst : runtime.platform.MemoryBuffer M)
  (exec : runtime.interp.Execution) (store : runtime.store.Store M)
  (inst : Std.Usize) (base : Std.Usize) (op : Std.U16)
  (instruction : runtime.bytecode.Instr) :
  Result ((core.result.Result Unit runtime.ExecError) × (runtime.store.Store
    M))
  := do
  let (addr, value, offset) ← runtime.interp.store_operands instruction
  runtime.interp.execute_store platformMemoryBufferInst exec store inst base op
    addr value offset

