/-- [itasca::runtime::interp::int::compare_int]:
    Source: 'src/runtime/interp/int.rs' -/
def runtime.interp.int.compare_int
  (op : Std.U16) (x : Std.U64) (y : Std.U64) (width : Std.U32) :
  Result Bool
  := do
  let i ← 64#u32 - width
  let i1 ← x <<< i
  let i2 ← lift (UScalar.hcast .I64 i1)
  let sx ← i2 >>> i
  let i3 ← y <<< i
  let i4 ← lift (UScalar.hcast .I64 i3)
  let sy ← i4 >>> i
  match op with
  | 0#uscalar => ok (x = y)
  | 1#uscalar => ok (x != y)
  | 2#uscalar => ok (sx < sy)
  | 3#uscalar => ok (x < y)
  | 4#uscalar => ok (sx > sy)
  | 5#uscalar => ok (x > y)
  | 6#uscalar => ok (sx <= sy)
  | 7#uscalar => ok (x <= y)
  | 8#uscalar => ok (sx >= sy)
  | _ => ok (x >= y)

