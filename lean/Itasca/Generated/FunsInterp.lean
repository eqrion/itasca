  {M : Type} {P : Type} {F : Type} {A : Type} (platformMemoryBufferInst :
  runtime.platform.MemoryBuffer M) (platformPlatformInst :
  runtime.platform.Platform P M) (platformFloatOpsInst :
  runtime.platform.FloatOps F) (platformAllocInst : runtime.platform.Alloc A)
  (store : runtime.store.Store M) (platform : P) («instance» : Std.Usize) :
  Result ((core.result.Result Unit runtime.ExecError) × (runtime.store.Store
    M) × P)
  := do
  let mi ←
    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
      runtime.store.ModuleInst) store.instances «instance»
  let (r, store1, platform1) ←
    runtime.interp.run_synthetic platformMemoryBufferInst platformPlatformInst
      platformFloatOpsInst platformAllocInst store platform «instance»
      mi.module.initialization
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue _ =>
    ok (core.result.Result.Ok (), store1, platform1)
  | core.ops.control_flow.ControlFlow.Break residual =>
    let r1 ←
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        Unit (core.convert.FromSame runtime.ExecError) residual
    ok (r1, store1, platform1)

end Itasca
