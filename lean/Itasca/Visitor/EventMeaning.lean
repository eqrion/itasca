  | 0xAD => some .i64_extend_i32_u
  | 0xAE => some .i64_trunc_f32_s
  | 0xAF => some .i64_trunc_f32_u
  | 0xB0 => some .i64_trunc_f64_s
  | 0xB1 => some .i64_trunc_f64_u
  | 0xB2 => some .f32_convert_i32_s
  | 0xB3 => some .f32_convert_i32_u
  | 0xB4 => some .f32_convert_i64_s
  | 0xB5 => some .f32_convert_i64_u
  | 0xB6 => some .f32_demote_f64
  | 0xB7 => some .f64_convert_i32_s
  | 0xB8 => some .f64_convert_i32_u
  | 0xB9 => some .f64_convert_i64_s
  | 0xBA => some .f64_convert_i64_u
  | 0xBB => some .f64_promote_f32
  | 0xBC => some .i32_reinterpret_f32
  | 0xBD => some .i64_reinterpret_f64
  | 0xBE => some .f32_reinterpret_i32
  | 0xBF => some .f64_reinterpret_i64
  | _ => none

/-- The opcode byte of each memory load or store callback, written as literals independent of the
extracted dispatch. -/
def MemoryHook.opcode : MemoryHook → U8
  | .i32_load => 0x28#u8
  | .i64_load => 0x29#u8
  | .f32_load => 0x2A#u8
  | .f64_load => 0x2B#u8
  | .i32_load8_s => 0x2C#u8
  | .i32_load8_u => 0x2D#u8
  | .i32_load16_s => 0x2E#u8
  | .i32_load16_u => 0x2F#u8
  | .i64_load8_s => 0x30#u8
  | .i64_load8_u => 0x31#u8
  | .i64_load16_s => 0x32#u8
  | .i64_load16_u => 0x33#u8
  | .i64_load32_s => 0x34#u8
  | .i64_load32_u => 0x35#u8
  | .i32_store => 0x36#u8
  | .i64_store => 0x37#u8
  | .f32_store => 0x38#u8
  | .f64_store => 0x39#u8
  | .i32_store8 => 0x3A#u8
  | .i32_store16 => 0x3B#u8
  | .i64_store8 => 0x3C#u8
  | .i64_store16 => 0x3D#u8
  | .i64_store32 => 0x3E#u8

/-- The specification instruction denoted by each memory callback name. -/
def MemoryHook.instruction : MemoryHook → code.MemArg → instr
  | .i32_load, arg => .LOAD .I32 none (MemoryMeaning.memArg arg)
  | .i64_load, arg => .LOAD .I64 none (MemoryMeaning.memArg arg)
  | .f32_load, arg => .LOAD .F32 none (MemoryMeaning.memArg arg)
  | .f64_load, arg => .LOAD .F64 none (MemoryMeaning.memArg arg)
  | .i32_load8_s, arg => .LOAD .I32 (some (.mk_loadop__0 .I32 (.mk_loadop_Inn (.mk_sz 8) .S))) (MemoryMeaning.memArg arg)
  | .i32_load8_u, arg => .LOAD .I32 (some (.mk_loadop__0 .I32 (.mk_loadop_Inn (.mk_sz 8) .U))) (MemoryMeaning.memArg arg)
  | .i32_load16_s, arg => .LOAD .I32 (some (.mk_loadop__0 .I32 (.mk_loadop_Inn (.mk_sz 16) .S))) (MemoryMeaning.memArg arg)
  | .i32_load16_u, arg => .LOAD .I32 (some (.mk_loadop__0 .I32 (.mk_loadop_Inn (.mk_sz 16) .U))) (MemoryMeaning.memArg arg)
  | .i64_load8_s, arg => .LOAD .I64 (some (.mk_loadop__0 .I64 (.mk_loadop_Inn (.mk_sz 8) .S))) (MemoryMeaning.memArg arg)
  | .i64_load8_u, arg => .LOAD .I64 (some (.mk_loadop__0 .I64 (.mk_loadop_Inn (.mk_sz 8) .U))) (MemoryMeaning.memArg arg)
  | .i64_load16_s, arg => .LOAD .I64 (some (.mk_loadop__0 .I64 (.mk_loadop_Inn (.mk_sz 16) .S))) (MemoryMeaning.memArg arg)
  | .i64_load16_u, arg => .LOAD .I64 (some (.mk_loadop__0 .I64 (.mk_loadop_Inn (.mk_sz 16) .U))) (MemoryMeaning.memArg arg)
  | .i64_load32_s, arg => .LOAD .I64 (some (.mk_loadop__0 .I64 (.mk_loadop_Inn (.mk_sz 32) .S))) (MemoryMeaning.memArg arg)
  | .i64_load32_u, arg => .LOAD .I64 (some (.mk_loadop__0 .I64 (.mk_loadop_Inn (.mk_sz 32) .U))) (MemoryMeaning.memArg arg)
  | .i32_store, arg => .STORE .I32 none (MemoryMeaning.memArg arg)
  | .i64_store, arg => .STORE .I64 none (MemoryMeaning.memArg arg)
  | .f32_store, arg => .STORE .F32 none (MemoryMeaning.memArg arg)
  | .f64_store, arg => .STORE .F64 none (MemoryMeaning.memArg arg)
  | .i32_store8, arg => .STORE .I32 (some (.mk_sz 8)) (MemoryMeaning.memArg arg)
  | .i32_store16, arg => .STORE .I32 (some (.mk_sz 16)) (MemoryMeaning.memArg arg)
  | .i64_store8, arg => .STORE .I64 (some (.mk_sz 8)) (MemoryMeaning.memArg arg)
  | .i64_store16, arg => .STORE .I64 (some (.mk_sz 16)) (MemoryMeaning.memArg arg)
  | .i64_store32, arg => .STORE .I64 (some (.mk_sz 32)) (MemoryMeaning.memArg arg)

/-- The memory callback for an opcode byte, or `none` if the byte is not a load or store. -/
def MemoryHook.ofOpcode (opcode : U8) : Option MemoryHook :=
  match opcode.val with
  | 0x28 => some .i32_load
  | 0x29 => some .i64_load
  | 0x2A => some .f32_load
  | 0x2B => some .f64_load
  | 0x2C => some .i32_load8_s
  | 0x2D => some .i32_load8_u
  | 0x2E => some .i32_load16_s
  | 0x2F => some .i32_load16_u
  | 0x30 => some .i64_load8_s
  | 0x31 => some .i64_load8_u
  | 0x32 => some .i64_load16_s
  | 0x33 => some .i64_load16_u
  | 0x34 => some .i64_load32_s
  | 0x35 => some .i64_load32_u
  | 0x36 => some .i32_store
  | 0x37 => some .i64_store
  | 0x38 => some .f32_store
  | 0x39 => some .f64_store
  | 0x3A => some .i32_store8
  | 0x3B => some .i32_store16
  | 0x3C => some .i64_store8
  | 0x3D => some .i64_store16
  | 0x3E => some .i64_store32
  | _ => none

/-- The specification instruction denoted by each Wasm 2.0 scalar callback. -/
def ExtendedNumericHook.instruction : ExtendedNumericHook → instr
  | .i32_extend8_s => .UNOP .I32 (.mk_unop__0 .I32 (.EXTEND 8))
  | .i32_extend16_s => .UNOP .I32 (.mk_unop__0 .I32 (.EXTEND 16))
  | .i64_extend8_s => .UNOP .I64 (.mk_unop__0 .I64 (.EXTEND 8))
  | .i64_extend16_s => .UNOP .I64 (.mk_unop__0 .I64 (.EXTEND 16))
  | .i64_extend32_s => .UNOP .I64 (.mk_unop__0 .I64 (.EXTEND 32))
  | .i32_trunc_sat_f32_s => .CVTOP .I32 .F32 (.mk_cvtop___2 .F32 .I32 (.TRUNC_SAT .S))
  | .i32_trunc_sat_f32_u => .CVTOP .I32 .F32 (.mk_cvtop___2 .F32 .I32 (.TRUNC_SAT .U))
  | .i32_trunc_sat_f64_s => .CVTOP .I32 .F64 (.mk_cvtop___2 .F64 .I32 (.TRUNC_SAT .S))
  | .i32_trunc_sat_f64_u => .CVTOP .I32 .F64 (.mk_cvtop___2 .F64 .I32 (.TRUNC_SAT .U))
  | .i64_trunc_sat_f32_s => .CVTOP .I64 .F32 (.mk_cvtop___2 .F32 .I64 (.TRUNC_SAT .S))
  | .i64_trunc_sat_f32_u => .CVTOP .I64 .F32 (.mk_cvtop___2 .F32 .I64 (.TRUNC_SAT .U))
  | .i64_trunc_sat_f64_s => .CVTOP .I64 .F64 (.mk_cvtop___2 .F64 .I64 (.TRUNC_SAT .S))
  | .i64_trunc_sat_f64_u => .CVTOP .I64 .F64 (.mk_cvtop___2 .F64 .I64 (.TRUNC_SAT .U))

/-- The first opcode byte of each Wasm 2.0 scalar callback: `0xC0` to `0xC4` for sign extension,
`0xFC` for saturating truncation. -/
def ExtendedNumericHook.opcode : ExtendedNumericHook → U8
  | .i32_extend8_s => 0xC0#u8
  | .i32_extend16_s => 0xC1#u8
  | .i64_extend8_s => 0xC2#u8
  | .i64_extend16_s => 0xC3#u8
  | .i64_extend32_s => 0xC4#u8
  | .i32_trunc_sat_f32_s => 0xFC#u8
  | .i32_trunc_sat_f32_u => 0xFC#u8
  | .i32_trunc_sat_f64_s => 0xFC#u8
  | .i32_trunc_sat_f64_u => 0xFC#u8
  | .i64_trunc_sat_f32_s => 0xFC#u8
  | .i64_trunc_sat_f32_u => 0xFC#u8
  | .i64_trunc_sat_f64_s => 0xFC#u8
  | .i64_trunc_sat_f64_u => 0xFC#u8

/-- The opcode byte of a Wasm 2.0 scalar callback with its `0xFC` sub-opcode, if it has one. -/
def ExtendedNumericHook.encoding : ExtendedNumericHook → U8 × Option U32
  | .i32_extend8_s => (0xC0#u8, none)
  | .i32_extend16_s => (0xC1#u8, none)
  | .i64_extend8_s => (0xC2#u8, none)
  | .i64_extend16_s => (0xC3#u8, none)
  | .i64_extend32_s => (0xC4#u8, none)
  | .i32_trunc_sat_f32_s => (0xFC#u8, some 0#u32)
  | .i32_trunc_sat_f32_u => (0xFC#u8, some 1#u32)
  | .i32_trunc_sat_f64_s => (0xFC#u8, some 2#u32)
  | .i32_trunc_sat_f64_u => (0xFC#u8, some 3#u32)
  | .i64_trunc_sat_f32_s => (0xFC#u8, some 4#u32)
  | .i64_trunc_sat_f32_u => (0xFC#u8, some 5#u32)
  | .i64_trunc_sat_f64_s => (0xFC#u8, some 6#u32)
  | .i64_trunc_sat_f64_u => (0xFC#u8, some 7#u32)

/-- The flat specification token that a completed callback stands for, given the `br_table` labels
observed so far. A table-label callback has no token of its own. -/
def Action.token (action : Action) (pending : List U32) : Option Wasm1.Token :=
  match action with
  | .unreachable => some (.plain .UNREACHABLE)
  | .nop => some (.plain .NOP)
  | .block .Empty => some (.block .Empty)
  | .block (.Value t) => some (.block (.Value t))
  | .block (.TypeIndex _) => none
  | .loop .Empty => some (.loop .Empty)
  | .loop (.Value t) => some (.loop (.Value t))
  | .loop (.TypeIndex _) => none
  | .if_ .Empty => some (.if_ .Empty)
  | .if_ (.Value t) => some (.if_ (.Value t))
  | .if_ (.TypeIndex _) => none
  | .else_ _ => some .else_
  | .end_ _ _ => some .end_
  | .br depth _ => some (.plain (.BR (.mk_uN depth.val)))
  | .br_if depth _ => some (.plain (.BR_IF (.mk_uN depth.val)))
  | .br_table_label _ => none
  | .br_table fallback _ => some (.plain (.BR_TABLE (pending.map (fun i => .mk_uN i.val)) (.mk_uN fallback.val)))
  | .return_ => some (.plain .RETURN)
  | .call idx => some (.plain (.CALL (.mk_uN idx.val)))
  | .call_indirect idx table => some (.plain (.CALL_INDIRECT (.mk_uN table.val) (.mk_uN idx.val)))
  | .drop _ => some (.plain .DROP)
  | .select _ => some (.plain (.SELECT none))
  | .local_get idx => some (.plain (.LOCAL_GET (.mk_uN idx.val)))
  | .local_set idx => some (.plain (.LOCAL_SET (.mk_uN idx.val)))
  | .local_tee idx => some (.plain (.LOCAL_TEE (.mk_uN idx.val)))
  | .global_get idx => some (.plain (.GLOBAL_GET (.mk_uN idx.val)))
  | .global_set idx => some (.plain (.GLOBAL_SET (.mk_uN idx.val)))
  | .memory_size => some (.plain .MEMORY_SIZE)
  | .memory_grow => some (.plain .MEMORY_GROW)
  | .i32_const value => some (.plain (Spec.i32Const value))
  | .i64_const value => some (.plain (ScalarConst.i64 value))
  | .f32_const bits => some (.plain (ScalarConst.f32 bits))
  | .f64_const bits => some (.plain (ScalarConst.f64 bits))
  | .numeric hook => some (.plain hook.instruction)
  | .extendedNumeric hook => some (.plain hook.instruction)
  | .ref_null a0 => some (.plain (.REF_NULL (Translate.referenceType a0)))
  | .ref_is_null => some (.plain .REF_IS_NULL)
  | .ref_func a0 => some (.plain (.REF_FUNC (.mk_uN a0.val)))
  | .select_typed a0 => some (.plain (.SELECT (some [Translate.valueType a0])))
  | .table_get a0 => some (.plain (.TABLE_GET (.mk_uN a0.val)))
  | .table_set a0 => some (.plain (.TABLE_SET (.mk_uN a0.val)))
  | .memory_init a0 => some (.plain (.MEMORY_INIT (.mk_uN a0.val)))
  | .data_drop a0 => some (.plain (.DATA_DROP (.mk_uN a0.val)))
  | .memory_copy => some (.plain .MEMORY_COPY)
  | .memory_fill => some (.plain .MEMORY_FILL)
  | .table_init a0 a1 => some (.plain (.TABLE_INIT (.mk_uN a1.val) (.mk_uN a0.val)))
  | .elem_drop a0 => some (.plain (.ELEM_DROP (.mk_uN a0.val)))
  | .table_copy a0 a1 => some (.plain (.TABLE_COPY (.mk_uN a0.val) (.mk_uN a1.val)))
  | .table_grow a0 => some (.plain (.TABLE_GROW (.mk_uN a0.val)))
  | .table_size a0 => some (.plain (.TABLE_SIZE (.mk_uN a0.val)))
  | .table_fill a0 => some (.plain (.TABLE_FILL (.mk_uN a0.val)))
  | .simd subopcode => (Wasm2.Simd.pureMeaning subopcode.val).map (fun op => .plain op.instruction)
  | .simd_lane subopcode lane => (Wasm2.Simd.laneMeaning subopcode.val).map
      (fun op => .plain (op.instruction (.mk_uN lane.val)))
  | .simd_memory subopcode arg => (Wasm2.Simd.memoryMeaning subopcode.val).map
      (fun op => .plain (op.instruction (MemoryMeaning.memArg arg) (.mk_uN 0)))
  | .simd_memory_lane subopcode arg lane => (Wasm2.Simd.memoryMeaning subopcode.val).map
      (fun op => .plain (op.instruction (MemoryMeaning.memArg arg) (.mk_uN lane.val)))
  | .simd_const low high => some (.plain (Wasm2.Simd.vectorConstant low high))
  | .simd_shuffle low high => some (.plain (Wasm2.Simd.shuffle low high))
  | .memory hook arg => some (.plain (hook.instruction arg))

/-- The opcode byte of a callback. The `br_table` label callback has none. -/
def Action.opcode : Action → Option U8
  | .unreachable => some 0x00#u8
  | .nop => some 0x01#u8
  | .block _ => some 0x02#u8
  | .loop _ => some 0x03#u8
  | .if_ _ => some 0x04#u8
  | .else_ _ => some 0x05#u8
  | .end_ _ _ => some 0x0B#u8
  | .br _ _ => some 0x0C#u8
  | .br_if _ _ => some 0x0D#u8
  | .br_table _ _ => some 0x0E#u8
  | .return_ => some 0x0F#u8
  | .call _ => some 0x10#u8
  | .call_indirect _ _ => some 0x11#u8
  | .drop _ => some 0x1A#u8
  | .select _ => some 0x1B#u8
  | .local_get _ => some 0x20#u8
  | .local_set _ => some 0x21#u8
  | .local_tee _ => some 0x22#u8
  | .global_get _ => some 0x23#u8
  | .global_set _ => some 0x24#u8
  | .memory_size => some 0x3F#u8
  | .memory_grow => some 0x40#u8
  | .i32_const _ => some 0x41#u8
  | .i64_const _ => some 0x42#u8
  | .f32_const _ => some 0x43#u8
  | .f64_const _ => some 0x44#u8
  | .br_table_label _ => none
  | .numeric hook => some hook.opcode
  | .extendedNumeric hook => some hook.opcode
  | .ref_null _ => some 0xD0#u8
  | .ref_is_null => some 0xD1#u8
  | .ref_func _ => some 0xD2#u8
  | .select_typed _ => some 0x1C#u8
  | .table_get _ => some 0x25#u8
  | .table_set _ => some 0x26#u8
  | .memory_init _ => some 0xFC#u8
  | .data_drop _ => some 0xFC#u8
  | .memory_copy => some 0xFC#u8
  | .memory_fill => some 0xFC#u8
  | .table_init _ _ => some 0xFC#u8
  | .elem_drop _ => some 0xFC#u8
  | .table_copy _ _ => some 0xFC#u8
  | .table_grow _ => some 0xFC#u8
  | .table_size _ => some 0xFC#u8
  | .table_fill _ => some 0xFC#u8
  | .simd _ | .simd_lane _ _ | .simd_memory _ _ | .simd_memory_lane _ _ _
  | .simd_const _ _ | .simd_shuffle _ _ => some 0xFD#u8
  | .memory hook _ => some hook.opcode

end Itasca.VisitorTrace
