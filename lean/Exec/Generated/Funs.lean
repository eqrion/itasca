def runtime.compiler.initialize.expression
  {A : Type} (platformAllocInst : runtime.platform.Alloc A)
  (module1 : _root_.Exec.runtime.compiler.ExecutableModule)
  (budget : _root_.Exec.runtime.compiler.Budget A)
  (expr : _root_.Itasca.types.ConstExpr) (ty : _root_.Itasca.types.ValueType) :
  Result ((core.result.Result Std.Usize _root_.Itasca.error.VisitError) ×
    _root_.Exec.runtime.compiler.ExecutableModule ×
    (_root_.Exec.runtime.compiler.Budget A))
  := do
  let i ← runtime.value.width ty
  let function ←
    runtime.bytecode.CompiledFunction.synthetic (alloc.vec.Vec.new
      _root_.Exec.runtime.bytecode.Instr) i
  let (r, budget1, function1) ←
    runtime.compiler.initialize.constant platformAllocInst budget function expr
      ty 0#u32
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue _ =>
    let (r1, budget2, v) ←
      runtime.compiler.initialize.emit platformAllocInst budget1 function1.code
        (runtime.bytecode.Instr.Return 0#u32 i)
    let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
    match cf1 with
    | core.ops.control_flow.ControlFlow.Continue _ =>
      let index := alloc.vec.Vec.len module1.functions
      let b ←
        runtime.bytecode.CompiledFunction.well_formed
          { function1 with code := v }
      if b
      then
        let (r2, budget3, v1) ←
          runtime.compiler.Budget.push platformAllocInst budget2
            module1.functions { function1 with code := v }
        let cf2 ← core.result.Result.Insts.CoreOpsTry.branch r2
        match cf2 with
        | core.ops.control_flow.ControlFlow.Continue _ =>
          ok (core.result.Result.Ok index, { module1 with functions := v1 },
            budget3)
        | core.ops.control_flow.ControlFlow.Break residual =>
          let r3 ←
            core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
              Std.Usize (core.convert.FromSame _root_.Itasca.error.VisitError)
              residual
          ok (r3, { module1 with functions := v1 }, budget3)
      else
        ok (core.result.Result.Err _root_.Itasca.error.VisitError.OutOfMemory,
          module1, budget2)
    | core.ops.control_flow.ControlFlow.Break residual =>
      let r2 ←
        core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
          Std.Usize (core.convert.FromSame _root_.Itasca.error.VisitError)
          residual
      ok (r2, module1, budget2)
  | core.ops.control_flow.ControlFlow.Break residual =>
    let r1 ←
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        Std.Usize (core.convert.FromSame _root_.Itasca.error.VisitError)
        residual
    ok (r1, module1, budget1)

