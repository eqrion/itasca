    let instruction ←
      match ty with
      | _root_.Itasca.types.ValueType.I32 =>
        ok (runtime.bytecode.Instr.GlobalGet dst global)
      | _root_.Itasca.types.ValueType.I64 =>
        ok (runtime.bytecode.Instr.GlobalGet dst global)
      | _root_.Itasca.types.ValueType.F32 =>
        ok (runtime.bytecode.Instr.GlobalGet dst global)
      | _root_.Itasca.types.ValueType.F64 =>
        ok (runtime.bytecode.Instr.GlobalGet dst global)
      | _root_.Itasca.types.ValueType.V128 =>
        ok (runtime.bytecode.Instr.GlobalGet2 dst global)
      | _root_.Itasca.types.ValueType.FuncRef =>
        ok (runtime.bytecode.Instr.GlobalGet dst global)
