+/- Handwritten builtin definitions: Float/Convert. -/
+section
+
+/-! Floating conversions: exact integer truncation and saturation; rational
+rounding for integer conversion and format conversion; representation-preserving
+reinterpretation. Canonical NaN classification uses the source format. -/
+
+open SpecExt.Builtins SpecExt.Builtins.Float
+
+def convert__ (source target : Nat) (sign : sx) (value : iN) : fN :=
+  let integer : Int := match sign with
+    | .S => signedValue source (proj_uN_0 value)
+    | .U => proj_uN_0 value
+  round target (integer : Rat)
+
+def demote__ (source target : Nat) (value : fN) : List fN :=
+  if isNaN value then
+    if canonicalInput source value then canonicalNaNs target else arithmeticNaNs target
+  else if isInf value || isZero value then [value]
+  else [round target (finiteValue source value)]
+
+/-- For the valid widening pair, rounding is exact. The same total format
+conversion also defines behavior on other width pairs, outside this builtin's domain. -/
+def promote__ (source target : Nat) (value : fN) : List fN := demote__ source target value
+
+def trunc__ (source target : Nat) (sign : sx) (value : fN) : Option iN :=
+  if isNaN value || isInf value then none
+  else
+    let integer := truncz (finiteValue source value)
+    let lower : Int := match sign with | .S => -(2 : Int) ^ (target - 1) | .U => 0
+    let upper : Int := match sign with | .S => (2 : Int) ^ (target - 1) | .U => 2 ^ target
+    if lower ≤ integer ∧ integer < upper then some (encodeSigned target integer) else none
+
+def trunc_sat__ (source target : Nat) (sign : sx) (value : fN) : Option iN :=
+  if isNaN value then some (.mk_uN 0)
+  else if isInf value then
+    some (saturate target sign (if negative value then -(2 : Int) ^ target else 2 ^ target))
+  else some (saturate target sign (truncz (finiteValue source value)))
+
+def reinterpret__ (source target : numtype) (value : num_) : num_ :=
+  match source, target, value with
+  | .I32, .F32, .mk_num__0 _ bits => .mk_num__1 .F32 (floatOfBits 32 (proj_uN_0 bits))
+  | .I64, .F64, .mk_num__0 _ bits => .mk_num__1 .F64 (floatOfBits 64 (proj_uN_0 bits))
+  | .F32, .I32, .mk_num__1 _ f => .mk_num__0 .I32 (.mk_uN (floatBits 32 f))
+  | .F64, .I64, .mk_num__1 _ f => .mk_num__0 .I64 (.mk_uN (floatBits 64 f))
+  | _, _, _ => value
+
+end
+
+/- Handwritten builtin definitions: Lanes. -/
+section
+
+/-! Vector lanes follow the pinned numerical prose: lane zero occupies the
+least significant bytes. Floating lanes preserve every bit, including NaN
+payloads and signed zero. Well-formed shapes and lane lists are the specified
+domain; these definitions are also total outside that domain. -/
+
+namespace SpecExt.Builtins
+
+def laneOfBits (ty : lanetype) (bits : Nat) : lane_ :=
+  match ty with
+  | .I8 => .mk_lane__0 .I8 (.mk_uN bits)
+  | .I16 => .mk_lane__0 .I16 (.mk_uN bits)
+  | .I32 => .mk_lane__0 .I32 (.mk_uN bits)
+  | .I64 => .mk_lane__0 .I64 (.mk_uN bits)
+  | .F32 => .mk_lane__1 .F32 (floatOfBits 32 bits)
+  | .F64 => .mk_lane__1 .F64 (floatOfBits 64 bits)
+
+def laneBits (ty : lanetype) : lane_ → Nat
+  | .mk_lane__0 _ (.mk_uN bits) => bits
+  | .mk_lane__1 _ value => floatBits (lsize ty) value
+
+def unpackLanes (ty : lanetype) : Nat → Nat → List lane_
+  | 0, _ => []
+  | count + 1, bits =>
+      laneOfBits ty (bits % 2 ^ lsize ty) :: unpackLanes ty count (bits / 2 ^ lsize ty)
+
+def packLanes (ty : lanetype) : List lane_ → Nat
+  | [] => 0
+  | lane :: rest => laneBits ty lane + 2 ^ lsize ty * packLanes ty rest
+
+
+end SpecExt.Builtins
+
+def lanes_ (v_shape : shape) (v_vec_ : vec_) : List lane_ :=
+  match v_shape with
+  | .X ty (.mk_dim count) => SpecExt.Builtins.unpackLanes ty count (proj_uN_0 v_vec_)
+
+def inv_lanes_ (v_shape : shape) (values : List lane_) : vec_ :=
+  .mk_uN (SpecExt.Builtins.packLanes (fun_lanetype v_shape) values)
+
+end
+
+/- Handwritten builtin definitions: Misc. -/
+section
+
+/-!
+The generated inverse-concat signature omits chunk sizes. The pinned SpecTec
+interpreter (`spectec/src/backend-interpreter/numerics.ml`, `inv_concat_helper`)
+uses consecutive pairs. This is an auxiliary implementation convention, not a
+left inverse for arbitrary lists of lists. The generated specification currently
+has no call sites. Odd-length inputs, rejected by the reference helper, are
+here totalized with a final singleton; no specification rule relies on that case.
+-/
+
+def inv_concat_ (X : Type) : List X → List (List X)
+  | [] => []
+  | [a] => [[a]]
+  | a :: b :: rest => [a, b] :: inv_concat_ X rest
+
+end
 
