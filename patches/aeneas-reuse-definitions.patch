diff --git a/src/extract/ExtractBuiltinCore.ml b/src/extract/ExtractBuiltinCore.ml
index 60961bd..0ab7253 100644
--- a/src/extract/ExtractBuiltinCore.ml
+++ b/src/extract/ExtractBuiltinCore.ml
@@ -191,3 +191,39 @@ let mk_trait_impl ?(keep_params : bool list option = None)
     (extract_name : string) : pattern * Pure.builtin_trait_impl_info =
   let rust_name = parse_pattern rust_name in
   (rust_name, { extract_name; keep_params; keep_trait_clauses })
+
+(** Reuse definitions from an earlier extraction without replacing Rust bodies.
+    The source types remain transparent to symbolic execution. The supplied map
+    only selects existing Lean names at extraction, just like builtin models.
+    Missing/ill-formed fields fail rather than silently dropping mappings. *)
+let reused_definitions = mk_memoized (fun () ->
+  match !Config.reuse_definitions with
+  | None -> ([], [], [])
+  | Some filename ->
+      if Config.backend () <> Lean then
+        failwith "-reuse-definitions is only supported by the Lean backend";
+      let open Yojson.Safe.Util in
+      let json = Yojson.Safe.from_file filename in
+      let list key obj = member key obj |> to_list in
+      let string key obj = member key obj |> to_string in
+      let pairs key obj = list key obj |> List.map (function
+        | `List [`String rust; `String lean] -> (rust, lean)
+        | _ -> failwith ("Invalid name pair in reuse definitions: " ^ key)) in
+      let types = list "types" json |> List.map (fun obj ->
+        let members = pairs "members" obj |> List.map (fun (r, l) -> (r, Some l)) in
+        let kind = match string "kind" obj with
+          | "struct" -> KStruct members
+          | "enum" -> KEnum members
+          | "opaque" when members = [] -> KOpaque
+          | _ -> failwith "Invalid type kind in reuse definitions" in
+        mk_type (string "rust" obj) (string "lean" obj) ~kind) in
+      let traits = list "traits" json |> List.map (fun obj ->
+        let parent_clauses = list "parents" obj |> List.map to_string in
+        mk_trait_decl (string "rust" obj) (string "lean" obj)
+          ~methods:(pairs "methods" obj) ~parent_clauses) in
+      let imports = list "imports" json |> List.map to_string in
+      (types, traits, imports))
+
+let reused_types () = let (types, _, _) = reused_definitions () in types
+let reused_traits () = let (_, traits, _) = reused_definitions () in traits
+let reused_imports () = let (_, _, imports) = reused_definitions () in imports
