new file mode 100644
index 0000000..863df77
--- /dev/null
+++ b/tests/src/namespace-shadow.rs
@@ -0,0 +1,55 @@
+//@ [!lean] skip
+//@ charon-args=--sysroot=default
+
+#![feature(register_tool)]
+#![register_tool(verify)]
+
+pub mod types {
+    pub enum Kind {
+        A,
+        B,
+    }
+
+    pub struct FuncType {
+        pub result: u32,
+    }
+
+    pub struct Generic<T> {
+        pub value: T,
+    }
+}
+
+pub mod module {
+    pub struct ImportDesc {
+        pub index: u32,
+    }
+
+    pub struct Import {
+        pub module: Vec<u8>,
+        pub desc: ImportDesc,
+    }
+
+    pub struct Env {
+        pub types: Vec<super::types::FuncType>,
+        pub func_types: Vec<super::types::FuncType>,
+        pub generic: super::types::Generic<super::types::Kind>,
+    }
+}
+
+// Local variables must not hide constructor or function namespaces either.
+pub fn constructor(types: u32) -> (u32, types::Kind) {
+    (types, types::Kind::A)
+}
+
+// Recursive references must continue to resolve while defining the type.
+pub struct Recursive {
+    pub next: Option<Box<Recursive>>,
+    pub value: types::Kind,
+}
+
+#[verify::test]
+pub fn test_constructor() {
+    let (n, k) = constructor(42);
+    assert!(n == 42);
+    assert!(matches!(k, types::Kind::A));
+}
